<% if (pagination && pagination.lastPage > 1) { %>
<div class="pagination-bar">
    <span class="pagination-summary tabular">
        Page <%= pagination.currentPage %> of <%= pagination.lastPage %> (<%= pagination.total %> total)
    </span>
    <div class="pagination-links">
        <% if (pagination.currentPage > 1) { %>
            <a class="btn btn-secondary btn-sm" href="<%= pagination.buildPageUrl(pagination.currentPage - 1) %>">Previous</a>
        <% } %>
        <% for (let p = 1; p <= pagination.lastPage; p++) { %>
            <a class="btn <%= p === pagination.currentPage ? 'btn-primary' : 'btn-secondary' %> btn-sm tabular" href="<%= pagination.buildPageUrl(p) %>"><%= p %></a>
        <% } %>
        <% if (pagination.currentPage < pagination.lastPage) { %>
            <a class="btn btn-secondary btn-sm" href="<%= pagination.buildPageUrl(pagination.currentPage + 1) %>">Next</a>
        <% } %>
    </div>
</div>
<% } %>
