<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Subject &amp; Requester</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Assigned To</th>
                <th>Updated</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        <% if (tickets.length > 0) { %>
            <% for (const ticket of tickets) { %>
            <tr>
                <td class="mono">#<%= ticket.id %></td>
                <td>
                    <a class="table-title" href="/tickets/<%= ticket.id %>"><%= ticket.subject %></a>
                    <span class="table-sub">Submitted by <%= ticket.user ? ticket.user.name : 'Unknown' %></span>
                </td>
                <td><%= ticket.category ? ticket.category.name : 'Unknown' %></td>
                <td><span class="badge priority-<%= ticket.priority %>"><%= ucfirst(ticket.priority) %></span></td>
                <td><span class="badge status-<%= ticket.status %>"><%= formatLabel(ticket.status) %></span></td>
                <td><%= ticket.technician ? ticket.technician.name : 'Unassigned' %></td>
                <td class="tabular"><%= formatDate(ticket.updatedAt) %></td>
                <td><a class="btn btn-subtle btn-sm" href="/tickets/<%= ticket.id %>">View</a></td>
            </tr>
            <% } %>
        <% } else { %>
            <tr>
                <td colspan="8" class="empty-state">
                    <p>No tickets match your current criteria.</p>
                    <% if (TicketPolicy.create(currentUser)) { %>
                        <a class="btn btn-primary btn-sm" href="/tickets/create">Create ticket</a>
                    <% } %>
                </td>
            </tr>
        <% } %>
        </tbody>
    </table>
</div>
