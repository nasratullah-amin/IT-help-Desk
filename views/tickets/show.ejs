<%- include('../layouts/header') %>
<div class="page-heading"><div><div class="eyebrow">TICKET #<%= ticket.id %></div><h1><%= ticket.subject %></h1><p class="muted">Submitted by <%= ticket.user ? ticket.user.name : 'Unknown' %> · <%= formatDateTime(ticket.createdAt) %></p></div><div class="heading-actions"><a class="btn btn-light" href="/tickets">Back to tickets</a><% if (TicketPolicy.update(currentUser, ticket)) { %><a class="btn btn-primary" href="/tickets/<%= ticket.id %>/edit">Edit ticket</a><% } %></div></div>
<div class="detail-grid"><section class="panel"><div class="panel-heading"><h2>Issue details</h2><span class="pill status-<%= ticket.status %>"><%= formatLabel(ticket.status) %></span></div><p class="description-text"><%= ticket.description %></p><div class="meta-grid"><div><small>Category</small><strong><%= ticket.category ? ticket.category.name : 'Unknown' %></strong></div><div><small>Priority</small><strong><span class="pill priority-<%= ticket.priority %>"><%= ucfirst(ticket.priority) %></span></strong></div><div><small>Assigned technician</small><strong><%= ticket.technician ? ticket.technician.name : 'Not assigned' %></strong></div><div><small>Last updated</small><strong><%= formatDateTime(ticket.updatedAt) %></strong></div></div>
<% if (currentUser.role === 'admin') { %><form class="inline-form assignment-form" method="POST" action="/tickets/<%= ticket.id %>/assign"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="PATCH"><label>Assign technician<select name="assigned_to"><option value="">Unassigned</option><% for (const technician of technicians) { %><option value="<%= technician.id %>" <%= ticket.assignedTo === technician.id ? 'selected' : '' %>><%= technician.name %></option><% } %></select></label><button class="btn btn-dark btn-sm">Save assignment</button></form><% } %>
<% if (TicketPolicy.manage(currentUser, ticket)) { %><form class="workflow-form" method="POST" action="/tickets/<%= ticket.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="PATCH"><h3>Update status</h3><div class="workflow-row"><select name="status" <%= statusOptions.length === 0 ? 'disabled' : '' %>><% for (const status of statusOptions) { %><option value="<%= status %>" <%= ticket.status === status ? 'selected' : '' %>><%= formatLabel(status) %></option><% } %></select><input name="note" placeholder="Optional update note" <%= statusOptions.length === 0 ? 'disabled' : '' %>><button class="btn btn-primary" <%= statusOptions.length === 0 ? 'disabled' : '' %>>Update</button></div></form><% } %>
<% if (ticket.attachments.length > 0) { %><div class="subsection"><h3>Attachments</h3><% for (const attachment of ticket.attachments) { %><a class="file-item" href="/attachments/<%= attachment.id %>/download"><%= attachment.originalName %> <small><%= (attachment.fileSize / 1024).toFixed(1) %> KB</small></a><% } %></div><% } %>
</section><aside class="panel"><h2>Status history</h2><div class="timeline"><% if (ticket.histories.length > 0) { %><% for (const history of ticket.histories) { %><div class="timeline-item"><strong><%= formatLabel(history.action) %></strong><p><%= history.note || 'Status updated' %></p><small><%= history.user ? history.user.name : 'Former user' %> · <%= formatDateTime(history.createdAt) %></small></div><% } %><% } else { %><p class="muted">No history yet.</p><% } %></div></aside></div>
<section class="panel comments-panel"><div class="panel-heading"><div><h2>Conversation</h2><p class="muted">Updates between the requester and support team.</p></div></div><% if (ticket.comments.length > 0) { %><% for (const comment of ticket.comments) { %><div class="comment"><div class="comment-avatar"><%= comment.user ? comment.user.name.slice(0, 1).toUpperCase() : '?' %></div><div><strong><%= comment.user ? comment.user.name : 'Former user' %> <% if (comment.user) { %><span class="role-tag"><%= ucfirst(comment.user.role) %></span><% } %></strong><small><%= formatDateTime(comment.createdAt) %></small><p><%= comment.body %></p></div></div><% } %><% } else { %><p class="muted">No comments yet.</p><% } %><% if (TicketPolicy.comment(currentUser, ticket)) { %><form method="POST" action="/tickets/<%= ticket.id %>/comments" class="comment-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><textarea name="body" rows="3" maxlength="3000" placeholder="Write a comment..." required></textarea><button class="btn btn-primary">Add comment</button></form><% } %> <% if (TicketPolicy.attach(currentUser, ticket)) { %><form method="POST" action="/tickets/<%= ticket.id %>/attachments" enctype="multipart/form-data" class="upload-row"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="file" name="attachment" required accept=".pdf,.png,.jpg,.jpeg,.txt,.doc,.docx"><button class="btn btn-light">Upload attachment</button></form><% } %></section>
<% if (TicketPolicy.delete(currentUser, ticket)) { %><form method="POST" action="/tickets/<%= ticket.id %>" class="delete-form" onsubmit="return confirm('Delete this ticket permanently?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="DELETE"><button class="btn btn-danger">Delete ticket</button></form><% } %>
<%- include('../layouts/footer') %>
