<%- include('../layouts/header') %>

<div class="page-header">
    <div>
        <h1>Tickets</h1>
        <p class="page-subtitle">Search, filter, sort, and manage support requests.</p>
    </div>
    <% if (TicketPolicy.create(currentUser)) { %>
        <div class="header-actions">
            <a class="btn btn-primary" href="/tickets/create">Create ticket</a>
        </div>
    <% } %>
</div>

<form method="GET" action="/tickets" class="filter-bar">
    <input
        type="search"
        name="search"
        placeholder="Search ID, subject, user, technician, or category"
        value="<%= query.search || '' %>"
        aria-label="Search tickets"
    >
    <select name="status" aria-label="Filter by status">
        <option value="">All statuses</option>
        <% for (const s of ['open','assigned','in_progress','resolved','closed']) { %>
            <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= formatLabel(s) %></option>
        <% } %>
    </select>
    <select name="priority" aria-label="Filter by priority">
        <option value="">All priorities</option>
        <% for (const p of ['low','medium','high','critical']) { %>
            <option value="<%= p %>" <%= query.priority === p ? 'selected' : '' %>><%= ucfirst(p) %></option>
        <% } %>
    </select>
    <select name="category_id" aria-label="Filter by category">
        <option value="">All categories</option>
        <% for (const category of categories) { %>
            <option value="<%= category.id %>" <%= String(query.category_id || '') === String(category.id) ? 'selected' : '' %>><%= category.name %></option>
        <% } %>
    </select>
    <% if (currentUser.role === 'admin') { %>
    <select name="technician_id" aria-label="Filter by technician">
        <option value="">All technicians</option>
        <option value="unassigned" <%= query.technician_id === 'unassigned' ? 'selected' : '' %>>Unassigned</option>
        <% for (const technician of technicians) { %>
            <option value="<%= technician.id %>" <%= String(query.technician_id || '') === String(technician.id) ? 'selected' : '' %>><%= technician.name %></option>
        <% } %>
    </select>
    <% } %>
    <input type="date" name="from" aria-label="Created from" title="Created from" value="<%= query.from || '' %>">
    <input type="date" name="to" aria-label="Created to" title="Created to" value="<%= query.to || '' %>">
    <select name="sort" aria-label="Sort tickets">
        <option value="newest" <%= (query.sort || 'newest') === 'newest' ? 'selected' : '' %>>Newest first</option>
        <option value="oldest" <%= query.sort === 'oldest' ? 'selected' : '' %>>Oldest first</option>
        <option value="updated" <%= query.sort === 'updated' ? 'selected' : '' %>>Recently updated</option>
        <option value="priority" <%= query.sort === 'priority' ? 'selected' : '' %>>Highest priority</option>
    </select>
    <button type="submit" class="btn btn-primary">Filter</button>
    <a class="btn btn-secondary" href="/tickets">Reset</a>
</form>

<section class="panel panel-flush">
    <%- include('./partials/table', { tickets: tickets }) %>
    <%- include('../partials/pagination', { pagination: pagination }) %>
</section>

<%- include('../layouts/footer') %>
