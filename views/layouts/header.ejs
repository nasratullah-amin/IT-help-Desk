<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'IT Help Desk' %> | IT Help Desk</title>
    <meta name="description" content="IT Help Desk Ticketing System for reporting, assigning, and resolving support tickets.">
    <meta property="og:title" content="IT Help Desk">
    <meta property="og:description" content="IT Help Desk Ticketing System for reporting, assigning, and resolving support tickets.">
    <script>
    (function () {
        try {
            var stored = localStorage.getItem('it_helpdesk_theme');
            document.documentElement.setAttribute('data-theme', stored === 'dark' ? 'dark' : 'light');
        } catch (e) {
            document.documentElement.setAttribute('data-theme', 'light');
        }
    })();
    </script>
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<% if (currentUser) { %>
<div class="app-shell">
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
    <aside class="sidebar" id="app-sidebar" aria-label="Primary navigation">
        <div class="sidebar-header">
            <a class="brand-link" href="/dashboard">
                <span class="brand-logo" aria-hidden="true">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3a2 2 0 0 0 0-4V7z"/><path d="M9 12h6"/></svg>
                </span>
                <span class="brand-text">IT Help Desk</span>
            </a>
            <button type="button" class="sidebar-close" id="sidebar-close" aria-label="Close navigation">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-group">
                <div class="nav-group-title">Workspace</div>
                <a class="nav-item <%= currentPath === '/dashboard' ? 'active' : '' %>" href="/dashboard">
                    <span class="nav-item-main">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                        <span>Dashboard</span>
                    </span>
                </a>
                <a class="nav-item <%= currentPath.startsWith('/tickets') && currentPath !== '/tickets/create' ? 'active' : '' %>" href="/tickets">
                    <span class="nav-item-main">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/></svg>
                        <span>Tickets</span>
                    </span>
                </a>
                <% if (TicketPolicy.create(currentUser)) { %>
                <a class="nav-item <%= currentPath === '/tickets/create' ? 'active' : '' %>" href="/tickets/create">
                    <span class="nav-item-main">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
                        <span>Create Ticket</span>
                    </span>
                </a>
                <% } %>
                <a class="nav-item <%= currentPath.startsWith('/notifications') ? 'active' : '' %>" href="/notifications">
                    <span class="nav-item-main">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                        <span>Notifications</span>
                    </span>
                    <% if (unreadNotificationsCount > 0) { %>
                        <span class="nav-count"><%= unreadNotificationsCount %></span>
                    <% } %>
                </a>
            </div>

            <% if (currentUser.role === 'admin') { %>
            <div class="nav-group">
                <div class="nav-group-title">Administration</div>
                <a class="nav-item <%= currentPath.startsWith('/categories') ? 'active' : '' %>" href="/categories">
                    <span class="nav-item-main">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
                        <span>Categories</span>
                    </span>
                </a>
                <a class="nav-item <%= currentPath.startsWith('/users') ? 'active' : '' %>" href="/users">
                    <span class="nav-item-main">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span>Users</span>
                    </span>
                </a>
            </div>
            <% } %>
        </nav>

        <div class="sidebar-footer">
            <div class="user-summary">
                <div class="user-avatar" aria-hidden="true"><%= currentUser.name.slice(0, 1).toUpperCase() %></div>
                <div class="user-meta">
                    <span class="user-name"><%= currentUser.name %></span>
                    <span class="user-role"><%= ucfirst(currentUser.role) %></span>
                </div>
            </div>
            <form method="POST" action="/logout">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-secondary btn-sm btn-block">Sign out</button>
            </form>
        </div>
    </aside>

    <div class="main-column">
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="menu-toggle" id="sidebar-open" aria-label="Open navigation">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
                </button>
                <nav class="breadcrumbs" aria-label="Breadcrumb">
                    <% if (Array.isArray(breadcrumbs) && breadcrumbs.length > 0) { %>
                        <% breadcrumbs.forEach((crumb, idx) => { %>
                            <% if (idx > 0) { %><span aria-hidden="true">/</span><% } %>
                            <% if (crumb.href && idx < breadcrumbs.length - 1) { %>
                                <a href="<%= crumb.href %>"><%= crumb.label %></a>
                            <% } else { %>
                                <span class="crumb-current"><%= crumb.label %></span>
                            <% } %>
                        <% }) %>
                    <% } else { %>
                        <span class="crumb-current"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></span>
                    <% } %>
                </nav>
            </div>

            <div class="topbar-actions">
                <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false" title="Toggle theme">
                    <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                    <span class="theme-toggle-label">Dark</span>
                </button>
                <a class="icon-link" href="/notifications" title="Notifications" aria-label="Notifications">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    <% if (unreadNotificationsCount > 0) { %>
                        <span class="icon-badge"><%= unreadNotificationsCount %></span>
                    <% } %>
                </a>
                <% if (TicketPolicy.create(currentUser)) { %>
                    <a class="btn btn-primary btn-sm" href="/tickets/create">New ticket</a>
                <% } %>
            </div>
        </header>

        <main class="page-content">
            <% if (success) { %>
                <div class="alert alert-success" role="status"><%= success %></div>
            <% } %>
            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-error" role="alert">
                    <strong>Please correct the following:</strong>
                    <ul>
                        <% for (const error of errors) { %>
                            <li><%= error %></li>
                        <% } %>
                    </ul>
                </div>
            <% } %>
<% } else { %>
<div class="auth-page">
    <div class="auth-topbar">
        <div class="auth-brand">
            <span class="brand-logo" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3a2 2 0 0 0 0-4V7z"/><path d="M9 12h6"/></svg>
            </span>
            <span class="brand-text">IT Help Desk</span>
        </div>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false" title="Toggle theme">
            <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            <span class="theme-toggle-label">Dark</span>
        </button>
    </div>
    <div class="auth-container">
        <% if (success) { %>
            <div class="alert alert-success" role="status"><%= success %></div>
        <% } %>
        <% if (errors && errors.length > 0) { %>
            <div class="alert alert-error" role="alert">
                <strong>Please correct the following:</strong>
                <ul>
                    <% for (const error of errors) { %>
                        <li><%= error %></li>
                    <% } %>
                </ul>
            </div>
        <% } %>
<% } %>
