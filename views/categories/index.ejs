<%- include('../layouts/header') %>
<div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>Ticket categories</h1><p class="muted">Manage the issue types available in the support portal.</p></div></div>
<div class="detail-grid">
    <section class="panel"><h2>Add category</h2><form method="POST" action="/categories" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="name" maxlength="80" required></label><label>Description<input name="description" maxlength="255"></label><button class="btn btn-primary">Create category</button></form></section>
    <section class="panel"><h2>Existing categories</h2>
        <% if (categories.length > 0) { %>
        <% for (const category of categories) { %>
        <div class="category-row category-row-edit">
            <form method="POST" action="/categories/<%= category.id %>" class="form-stack category-fields"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="PUT"><input type="hidden" name="is_active" value="0">
                <label>Name<input name="name" value="<%= category.name %>" maxlength="80" required></label>
                <label>Description<input name="description" value="<%= category.description || '' %>" maxlength="255"></label>
                <label class="check-line"><input type="checkbox" name="is_active" value="1" <%= category.isActive ? 'checked' : '' %>> Active</label>
                <small><%= category.ticketsCount %> tickets</small><button class="btn btn-light btn-sm">Save changes</button>
            </form>
            <% if (category.ticketsCount === 0) { %><form method="POST" action="/categories/<%= category.id %>" onsubmit="return confirm('Delete this category?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="DELETE"><button class="btn btn-danger btn-sm">Delete</button></form><% } %>
        </div>
        <% } %>
        <% } else { %><p class="muted">No categories have been created.</p><% } %>
    </section>
</div>
<%- include('../layouts/footer') %>
