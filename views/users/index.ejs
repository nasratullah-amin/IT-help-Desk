<%- include('../layouts/header') %>
<div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>User management</h1><p class="muted">Manage portal access and assign system roles.</p></div></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Current role</th><th>Change role</th><th>Joined</th></tr></thead><tbody><% for (const user of users) { %><tr><td><%= user.name %></td><td><%= user.email %></td><td><%= ucfirst(user.role) %></td><td><form method="POST" action="/users/<%= user.id %>/role" class="role-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="PATCH"><select name="role"><% for (const role of ['user','technician','admin']) { %><option value="<%= role %>" <%= user.role === role ? 'selected' : '' %>><%= ucfirst(role) %></option><% } %></select><button class="btn btn-dark btn-sm">Save</button></form></td><td><%= formatDate(user.createdAt) %></td></tr><% } %></tbody></table></div><%- include('../partials/pagination', { pagination: pagination }) %></section>
<%- include('../layouts/footer') %>
